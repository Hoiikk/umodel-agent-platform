DATA_AGENT_MODEL=qwen3.8-flash
UMODEL_ADDR=http://127.0.0.1:8080
UMODEL_WORKSPACE=rms
UMODEL_AUTH_MODE=dev_header
UMODEL_DEV_USER=dev
UMODEL_DEV_TENANT=acme
RMS_MYSQL_ENDPOINT=127.0.0.1:3308
